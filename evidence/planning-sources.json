  "sources": [
    {
      "id": "sf-glass",
      "title": "SF DBI / WJE \u00b7 March 2023 glass investigation",
      "url": "https://media.api.sf.gov/documents/BIC_Meeting_092023_-_Item_9.pdf",
      "published": "2023-09-20",
      "locator": "Slides 5\u20138; table on PDF page 6",
      "kind": "Post-storm forensic investigation",
      "finding": "Investigators examined 31 broken panes at seven buildings. They judged the likely causes of 30 identifiable and mitigable before the storms; this was not a measured prevention rate.",
      "sha256": "51a73ed32545d14baefe6068b40107fa5b725a1f8a7cefe1fcb24f4cd862c8ee"
    },
    {
      "id": "uf-trees",
      "title": "UF/IFAS \u00b7 Wind and Trees: Lessons Learned from Hurricanes",
      "url": "https://ask.ifas.ufl.edu/publication/FR173",
      "published": "Study includes Hurricane Andrew (1992)",
      "locator": "Lessons about trees, lesson 9",
      "kind": "Post-storm observational comparison",
      "finding": "After Andrew, studied broad-leaved species with proper prior pruning had 73% survival versus 47% without. The comparison is observational and does not establish a San Francisco or last-minute pruning effect."
    },
    {
      "id": "sandy",
      "title": "FEMA P-942 \u00b7 Hurricane Sandy field investigation",
      "url": "https://www.govinfo.gov/content/pkg/GOVPUB-HS5_100-PURL-gpo110213/pdf/GOVPUB-HS5_100-PURL-gpo110213.pdf",
      "published": "2013-11",
      "locator": "\u00a73.1.3; \u00a74.2.2\u20134.2.3; \u00a75.3.4\u20135.3.5",
      "kind": "Post-storm field investigation",
      "finding": "Foundation depth affected scour damage. A garage slab was damaged by flood loading. Floodgates were overtopped; protected fuel equipment survived. Functional backup systems supported operations; submerged transfer switches or pumps defeated some elevated generators."
    },
    {
      "id": "sf-works",
      "title": "San Francisco Public Works \u00b7 January 2023 storm response",
      "url": "https://www.sfpublicworkstv.org/es/january2023",
      "published": "2023-01",
      "locator": "Storm Response; catch basins and flooded intersections",
      "kind": "Operator account",
      "finding": "Crews handled tree, road, power-line and drainage incidents together. Counts are service orders, not independent failures or measured benefits of preparation."
    },
    {
      "id": "sf-311",
      "title": "DataSF \u00b7 historical 311 reports in this area",
