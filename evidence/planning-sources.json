  "hazards": [
    {
      "id": "wind",
      "label": "Wind & flying debris",
      "role": "building",
      "check": "Inspect glazing, window hardware and loose roof or balcony items",
      "action": "Secure loose items and have the owner repair identified glazing or hardware defects",
      "benefit": "Reduce falling-glass and windborne-debris exposure where a correctable defect is found.",
      "needs": [
        "Owner access and current inspection",
        "Suitable repair or securing method",
        "Clear public area below any work"
      ],
      "source_ids": [
        "sf-glass"
      ],
      "validation": "Local failure mechanism supported",
      "validation_detail": "The investigation supports finding and correcting defects. It does not validate a percentage reduction for these buildings today.",
      "transfer": "No local damage reduction has been measured."
    },
    {
      "id": "trees",
      "label": "Falling trees",
      "role": "arborist",
      "check": "Re-inspect trees at historical fallen-tree report locations",
      "action": "Have an arborist address confirmed defects; arrange specialist pruning or removal if warranted",
      "benefit": "Reduce failure exposure for the particular defect and tree addressed.",
      "needs": [
        "Current arborist assessment",
        "Tree ownership and access confirmed",
        "Utility clearance if wires may be involved"
      ],
      "source_ids": [
        "uf-trees",
        "sf-works"
      ],
      "validation": "External observational evidence",
      "validation_detail": "The Andrew comparison supports proper maintenance, not an emergency pruning recipe. Species, roots, decay and local exposure must be assessed.",
      "transfer": "The 73% versus 47% historical survival comparison is not a predicted benefit here."
    },
    {
      "id": "structure",
      "label": "Structural collapse",
      "role": "building",
      "check": "Have an engineer review roof, wall, connection and foundation concerns",
      "action": "Use an engineer-designed repair or temporary support; restrict exposure if the structure cannot be made ready",
      "benefit": "Address a verified failure mechanism; reducing exposure does not strengthen a structure.",
      "needs": [
        "Current condition and structural system",
        "Engineer assessment of wind, flood loading and scour where relevant",
        "Designed repair or support, permits and access"
      ],
      "source_ids": [
        "sandy"
      ],
      "validation": "Mechanism documented; local benefit unmeasured",
      "validation_detail": "Sandy field evidence distinguishes foundation scour and flood-loaded slabs. A generic roof brace does not address every collapse mode.",
      "transfer": "Neither whole-building collapse likelihood nor bracing benefit is validated here."
    },
    {
      "id": "flood",
      "label": "Flooding",
      "role": "general",
      "check": "Check inlets, thresholds, backflow paths and stored goods at reported flood locations",
      "action": "Clear confirmed surface blockages; use a suitable, fitted barrier and move vulnerable goods where the owner can do so",
      "benefit": "Reduce a confirmed entry path or blocked inlet, within the protection system\u2019s capacity.",
      "needs": [
        "Current inlet or entry-path inspection",
        "Barrier fit, height and drainage/backflow checked",
        "Storage relocation or safe overflow plan"
      ],
      "source_ids": [
        "sf-311",
        "sf-works",
        "sandy"
      ],
      "validation": "Failure limits documented",
      "validation_detail": "Sandy\u2019s 42-inch gates were overtopped. Local 311 flooding reports do not show whether inlet clearing or a barrier would have prevented those incidents.",
      "transfer": "The earlier 400 m\u00b3 simulated saving has no field validation and is not used."
    },
    {
      "id": "power",
      "label": "Power loss",
      "role": "electrician",
      "check": "Identify critical loads and test the complete backup power chain",
      "action": "Arrange a compatible, tested backup supply with protected switching, fuel and distribution",
      "benefit": "Maintain verified critical loads during an outage, for the tested runtime.",
      "needs": [
        "Critical load and compatible connection confirmed",
        "Generator, fuel, switchgear and pumps protected and tested",
        "Owner and electrician approval"
      ],
      "source_ids": [
        "sandy",
        "pge",
        "cec"
      ],
      "validation": "Operational benefit observed elsewhere",
      "validation_detail": "In one documented Manhattan building, staff connected additional sump pumps to emergency power before Sandy; generators remained operational. Other facilities lost backup when supporting components flooded.",
      "transfer": "No building-to-feeder mapping or avoided outage duration is established here."
    },
    {
      "id": "routes",
      "label": "Blocked routes",
      "role": "traffic",
      "check": "Survey access and an alternative around historical tree and flood reports",
      "action": "Prepare an authorized closure and a verified alternative before exposure becomes unsafe",
      "benefit": "Keep people away from a confirmed hazard while preserving needed access.",
      "needs": [
        "Primary and alternative route checked",
        "Emergency and accessible access retained",
        "Traffic authority and closure trigger agreed"
      ],
      "source_ids": [
        "sf-works",
        "sf-311"
      ],
      "validation": "Incident mechanism documented",
      "validation_detail": "SF crews documented tree-related road closures and power-line obstructions. No matched evidence measures how much a proposed cordon reduces exposure.",
      "transfer": "Closure is not counted as less physical damage or proven safer access."
    }
  ],
